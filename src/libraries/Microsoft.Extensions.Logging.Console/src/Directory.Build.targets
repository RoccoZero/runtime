<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Build.targets, $(MSBuildThisFileDirectory)..))" />

  <PropertyGroup Condition="'$(RoccoZeroPackageVersion)' != ''">
    <PackageId>RoccoZero.Microsoft.Extensions.Logging.Console</PackageId>
    <PackageVersion>$(RoccoZeroPackageVersion)</PackageVersion>
    <EnablePackageValidation>false</EnablePackageValidation>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Divine.Common" Key="" />
  </ItemGroup>

</Project>
